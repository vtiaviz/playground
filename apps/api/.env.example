# Copie para .env e ajuste
DATABASE_URL="postgresql://playground:playground@localhost:5432/playground?schema=public"
# Banco SEPARADO usado só pelos testes (o conteúdo dele é apagado a cada execução!)
DATABASE_URL_TEST="postgresql://playground:playground@localhost:5432/playground_test?schema=public"

# Em produção use um segredo aleatório com 32+ caracteres (ex.: openssl rand -hex 32)
JWT_SECRET="troque-por-um-segredo-longo-com-32-ou-mais-caracteres"
JWT_EXPIRES_IN="8h"

PORT=3333
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:5173"

# Usuários criados por `npm run db:seed`
SEED_INSTRUCTOR_NAME="Instrutor"
SEED_INSTRUCTOR_LOGIN="instrutor@exemplo.com"
SEED_INSTRUCTOR_PASSWORD="Instrutor2026!"

# ---------- Gerador de conteúdo com IA ----------
# Chave grátis, sem cartão: https://console.groq.com/keys (fica só no servidor, nunca vai para o navegador)
AI_API_KEY=""
# Qualquer API compatível com a da OpenAI. Exemplos:
#   Groq (padrão)  AI_BASE_URL="https://api.groq.com/openai/v1"                          AI_MODEL="openai/gpt-oss-120b"
#   Gemini         AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai" AI_MODEL="gemini-flash-latest"
#   OpenRouter     AI_BASE_URL="https://openrouter.ai/api/v1"                            AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
#   Ollama local   AI_BASE_URL="http://localhost:11434/v1"                               AI_MODEL="llama3.1"
AI_BASE_URL="https://api.groq.com/openai/v1"
# Modelos do Groq mudam: a lista atual fica em https://console.groq.com/docs/models
AI_MODEL="openai/gpt-oss-120b"
# O plano grátis do Groq aceita 8 mil tokens/min POR PEDIDO (texto enviado + AI_MAX_OUTPUT_TOKENS).
# 8000 caracteres de material (~2.500 tokens) + 4000 de resposta cabem com folga.
AI_MAX_SOURCE_CHARS=8000
AI_MAX_OUTPUT_TOKENS=4000
# Gerações por instrutor a cada 10 minutos
AI_RATE_LIMIT=20

# ---------- Tutor IA dos jogos ----------
# Usa a mesma AI_API_KEY e o mesmo AI_MODEL. "false" desliga o botão de ajuda em todos os jogos.
AI_TUTOR_ENABLED=true
# Segundos sem nenhuma interação na mesma pergunta/palavra até o tutor oferecer ajuda (0 = nunca oferece)
AI_TUTOR_IDLE_SECONDS=60
# Pedidos de ajuda por aluno a cada 10 minutos
AI_TUTOR_RATE_LIMIT=15
